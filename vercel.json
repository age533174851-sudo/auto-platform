{
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run vercel-build",
  "regions": [
    "hnd1"
  ],
  "crons": [
    {
      "path": "/api/autotrade/daily-ladder",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/autotrade/exit-monitor",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/autotrade/scheduled-exit",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/ai-scoring",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "0 5 * * *"
    }
  ]
}
