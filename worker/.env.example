# TRAIGO Worker — 환경변수
#
# 이 표는 **소스와 갈리면 CI가 빨개진다**
# (`scripts/test-worker-env-example.mjs`). 손으로 맞추지 않아도 된다.
#
# 왜 그렇게 해 뒀나: 예전에 이 표에 `APP_URL`과 `ADMIN_SECRET`이 없었다.
# 둘 다 없으면 워커는 **뜨고, 심장박동도 찍고, 로그도 깨끗한데 예약을
# 하나도 깨우지 않는다.** 오류가 안 난다. 표대로 세팅한 사람은
# "자동매매가 왜 안 되지"를 며칠 찾게 된다.

# ── 필수 ── 이게 없으면 예약 평가가 아예 안 돈다 ──

# Supabase (service role — DB 전체 권한, 절대 클라이언트 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 워커가 부를 앱 주소. 워커는 거래소에 직접 주문하지 않고 **이 앱을 부른다**
# (거래소가 워커 호스트의 IP 지역을 차단하기 때문이다).
# 예: https://auto-platform-zeta.vercel.app  (끝 슬래시 없이)
APP_URL=

# 그 호출의 인증. **Vercel의 `ADMIN_SECRET`과 반드시 같은 값**이어야 한다.
# 다르면 모든 호출이 401이고, 워커는 살아 있는 채로 아무것도 못 한다.
ADMIN_SECRET=

# 거래소 API secret 복호화 키
# ★ Vercel의 EXCHANGE_ENCRYPTION_KEY와 반드시 동일한 값 ★
# (ENCRYPTION_KEY / EXCHANGE_ENCRYPTION_KEY 둘 중 아무 이름으로 넣어도 인식)
ENCRYPTION_KEY=

# ── 선택 ──

# Upstash Redis (job/action 락 — 미설정 시 Supabase worker_lock 폴백)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram (Vercel과 동일 값)
TELEGRAM_MONEY_BOT_TOKEN=
TELEGRAM_MONEY_CHAT_ID=
TELEGRAM_SYSTEM_BOT_TOKEN=
TELEGRAM_SYSTEM_CHAT_ID=
# (듀얼봇 미설정 시 폴백)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 루프 주기(초), 워커 식별자
WORKER_POLL_SEC=3
WORKER_ID=worker-1

# 각 주기 작업의 간격(ms). 비워 두면 코드의 기본값을 쓴다.
EXIT_MONITOR_INTERVAL_MS=
SCHEDULED_EXIT_INTERVAL_MS=
PAPER_EXIT_INTERVAL_MS=
LEDGER_SYNC_INTERVAL_MS=
EQUITY_SNAPSHOT_INTERVAL_MS=
CHALLENGE_SWEEP_INTERVAL_MS=
