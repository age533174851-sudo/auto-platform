# TRAIGO Worker — Railway 환경변수

# Supabase (service role — DB 전체 권한, 절대 클라이언트 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 거래소 API secret 복호화 키
# ★ Vercel의 EXCHANGE_ENCRYPTION_KEY와 반드시 동일한 값 ★
# (ENCRYPTION_KEY / EXCHANGE_ENCRYPTION_KEY 둘 중 아무 이름으로 넣어도 인식)
ENCRYPTION_KEY=
# EXCHANGE_ENCRYPTION_KEY=

# Upstash Redis (job/action 락 — 미설정 시 Supabase worker_lock 폴백)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram (Vercel과 동일 값)
TELEGRAM_MONEY_BOT_TOKEN=
TELEGRAM_MONEY_CHAT_ID=
TELEGRAM_SYSTEM_BOT_TOKEN=
TELEGRAM_SYSTEM_CHAT_ID=
# (듀얼봇 미설정 시 폴백)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ★ 이 둘이 없으면 워커는 뜨고 잡도 처리하는데 **포지션을 지키지 않습니다** ★
# 청산 감시(트레일링·본전이동·시간청산) · 예약 청산 · 모의 청산 · 챌린지 정리가
# 한 번도 돌지 않고, heartbeat 는 정상이라 밖에서는 건강한 워커로 보입니다.
# 확인: WORKER_BOOT_CHECK=1 로 띄우면 종료코드 2 와 함께 무엇이 안 도는지 적습니다.
APP_URL=
ADMIN_SECRET=

# 루프 주기(초), 워커 식별자
WORKER_POLL_SEC=3
WORKER_ID=worker-1
