# ═══════════════════════════════════════════════════════════════
# TRAIGO Environment Variables — copy to .env.local
# All keys are server-side only (no NEXT_PUBLIC_ prefix)
# ═══════════════════════════════════════════════════════════════

# ── App URL (required for /api/market aggregator) ─────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_MODE=production

# ── Site URL for auth email redirects (required for prod) ─────
# 이메일 인증 / 비밀번호 재설정 링크가 이 도메인의 /auth/callback 으로 옵니다.
# 미설정 시 window.location.origin 사용 (개발 환경에서만 안전)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Supabase (optional — auth/DB features) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Market Data Providers (all optional — mock fallback) ──────
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
EODHD_API_KEY=
NEWS_API_KEY=
EXCHANGE_RATE_API_KEY=
COMMODITY_API_KEY=

# ── FinancialJuice (widget mode = no key needed) ──────────────
FINANCIALJUICE_MODE=widget
FINANCIALJUICE_API_KEY=

# ── AI / Briefing ─────────────────────────────────────────────
#
# 다 필요하지 않다. 하나만 있어도 뉴스 분석이 돈다 (없는 공급자는 조용히
# 건너뛴다). 하나도 없으면 각 단계가 503으로 그 사실을 알려준다.
#
# 키를 하나만 넣고 여러 AI를 쓰고 싶으면 아래 OPENROUTER_API_KEY를 보라.
#
# 단, 합의 분석(/api/ai/consensus)은 **최소 2개**가 필요하다. 하나로는
# 의견이 갈리는지 볼 수 없어서 400으로 거절한다.
#
# 지금 무엇이 설정돼 있는지는 GET /api/ai/providers/status 로 확인한다
# (키 값은 내보내지 않는다).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 키 하나로 여러 AI 쓰기 (OpenRouter) ───────────────────────
#
# openrouter.ai는 **중계**다. 키 하나·결제 하나로 GPT·Claude·Gemini·Grok·
# Perplexity를 전부 부를 수 있다. API 형식이 OpenAI와 같아서 그대로 붙는다.
#
# 규칙은 하나다: **그 회사 키가 있으면 직접 간다.** OpenRouter는 키가 없는
# 제공자에만 쓰인다. 직접 연결이 (1) 중계 수수료가 없고 (2) 중계가 죽어도
# 살아 있기 때문이다. 그래서 무료 한도가 있는 GEMINI_API_KEY 하나는 직접
# 넣어 두는 것을 권한다 — 중계가 멈춰도 그건 돈다.
#
# 비용: OpenRouter는 원가에 수수료를 붙인다. 관리센터의 비용 추정치는
# 원가 기준이라 **실제 청구액의 하한**이다.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 모델 ID는 자주 바뀐다. 기본값은 '회사/직접호출모델'을 조립한 것이라
# (gpt-4o → openai/gpt-4o) OpenRouter 목록에 없으면 **404**가 난다.
# 그때 여기서 맞춘다 — 오류 메시지에 모델 ID가 그대로 담긴다.
# OPENROUTER_MODEL_OPENAI=openai/gpt-4o
# OPENROUTER_MODEL_ANTHROPIC=anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL_GEMINI=google/gemini-2.5-pro
# OPENROUTER_MODEL_GROK=x-ai/grok-4
# OPENROUTER_MODEL_PERPLEXITY=perplexity/sonar-pro

# ── Grok · Perplexity 직접 연결 (선택) ────────────────────────
# 둘 다 OpenAI 호환 형식이라 키만 있으면 바로 붙는다.
# 모델 ID가 자주 바뀌므로 404가 나면 GROK_MODEL / PERPLEXITY_MODEL로 맞춘다.
XAI_API_KEY=
PERPLEXITY_API_KEY=
# GROK_MODEL=grok-4
# PERPLEXITY_MODEL=sonar

# 모델 덮어쓰기 (선택). 공급자가 모델 ID를 바꾸면 코드 수정 없이 여기서 맞춘다.
# cheap = 뉴스 분류처럼 자주 부르는 일, premium = 심층 판단.
# ⚠ Anthropic은 모델을 나누지 않는다. 깊이/비용을 effort로 조절하므로
#    ANTHROPIC_MODEL 하나뿐이고, 저가 경로가 없다 — 뉴스 크론처럼 하루
#    수백 번 부르는 자리에 Anthropic만 두면 요금이 가장 많이 나온다.
# OPENAI_MODEL_CHEAP=gpt-4o-mini
# OPENAI_MODEL_PREMIUM=gpt-4o
# GEMINI_MODEL_CHEAP=gemini-2.0-flash
# GEMINI_MODEL_PREMIUM=gemini-2.5-pro
# ANTHROPIC_MODEL=claude-opus-5

# 어느 공급자를 먼저 쓸지 (선택). 비워 두면 openai → anthropic → gemini 순.
# 이름만 적고 키를 안 넣으면 조용히 다른 공급자로 넘어가므로,
# /api/ai/providers/status가 그 경우를 경고로 알려준다.
# AI_DEFAULT_PROVIDER=gemini
# AI_FALLBACK_PROVIDERS=openai

# ── Exchange Trading (optional — real orders) ─────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=

# ── Alerts / Telegram (optional) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_SECRET=
# ── 시장 국면 필터 (기본 꺼짐) ────────────────────────────────
# 지금 국면이 진입에 맞을 때만 들어간다. 일봉 60개 이상으로 판정한다.
#
#   off         판정만 하고 막지 않는다 (기본) — 국면은 화면에 계속 표시된다
#   any         고변동장 차단 + 역추세 진입 차단 (하락장 롱 / 상승장 숏)
#   trend_only  추세장에서만. 횡보장 차단
#   range_only  횡보장에서만. 추세장 차단
#
# 일일 손실 한도와 달리 **기본이 꺼짐**인 이유: 손실 한도는 피해 크기만
# 제한하지만, 국면 필터는 **어떤 거래를 할지 자체를 바꾼다.** 만들어 둔
# 전략의 신호를 조용히 거부하기 시작하면 그건 다른 전략이 된다.
#
# 켜면 자동 경로(일일 사다리·TradingView 웹훅)의 진입에 적용된다.
# 시세를 못 받아 국면을 판정하지 못하면 **진입하지 않는다.**
REGIME_FILTER=

# ── 일일 손실 한도 (서버에서 강제) ────────────────────────────
# 오늘 잃은 금액이 한도에 닿으면 **신규 진입이 잠긴다.** 청산은 계속 된다 —
# 못 나가게 막으면 손실을 키우는 잠금이 된다.
#
# 손익은 거래소 원장(income/account_book)에서 읽는다. 실현손익 + 수수료 +
# 펀딩을 모두 센다. 하루 경계는 UTC 자정(거래소 기록과 펀딩 정산 기준)이다.
#
#   DAILY_MAX_LOSS_USD    절대 금액(USDT). 입출금이 있어도 어긋나지 않는다
#   DAILY_MAX_LOSS_PCT    시작 자산 대비 %. 둘 다 있으면 **작은 쪽**이 이긴다
#   DAILY_PROFIT_TARGET_PCT  목표 수익에 닿아도 멈춘다 (선택)
#
# 아무것도 안 적으면 DAILY_MAX_LOSS_PCT=5 가 걸린다. 한도 없이 자동매매가
# 도는 상태를 기본값으로 두지 않기 위해서다.
DAILY_MAX_LOSS_USD=
DAILY_MAX_LOSS_PCT=
DAILY_PROFIT_TARGET_PCT=

# ── 주간 손실 한도 · 연패 잠금 (기본 켜짐) ────────────────────
# 하루 한도가 못 보는 자리를 막는다.
#
#   월 −2.8% · 화 −2.9% · 수 −2.7% · 목 −2.9% · 금 −2.6%
#
# 매일 한도(−3%)를 안 넘었으니 하루 잠금은 **한 번도 안 걸린다.** 그런데
# 한 주에 −13%다. 하루 단위로만 보면 이 주를 볼 수 있는 눈이 없다.
#
#   WEEKLY_MAX_LOSS_PCT     주 시작 자산 대비 % (기본 7)
#   WEEKLY_MAX_LOSS_USD     절대 금액. 둘 다 있으면 **작은 쪽**이 이긴다
#   MAX_CONSECUTIVE_LOSSES  이만큼 연속 손절이면 잠근다 (기본 5)
#   LOSS_STREAK_LOCK_HOURS  연패 잠금 길이(시간). 비우면 다음 UTC 자정까지
#
# 주 경계는 **UTC 월요일 0시**다. 일요일 시작으로 하면 주말에 걸친 손실이
# 두 주로 쪼개진다.
#
# 끄려면 `off`를 적는다 (WEEKLY_MAX_LOSS_PCT=off). 셋 다 **신규 진입만**
# 잠근다 — 청산은 계속된다. 못 나가게 막는 잠금은 손실을 키우는 잠금이다.
WEEKLY_MAX_LOSS_PCT=
WEEKLY_MAX_LOSS_USD=
MAX_CONSECUTIVE_LOSSES=
LOSS_STREAK_LOCK_HOURS=

# ── 트레일링 · 본전 이동 (기본 켜짐) ──────────────────────────
# 이익이 난 뒤 손절을 **좁히기만** 한다. 진입가에서 멀어지는 방향으로는
# 절대 옮기지 않는다 — 그건 손실 한도를 넓히는 것이다.
#
# R = 진입가와 **진입 시점** 손절가의 거리. 손절이 움직여도 1R은 그대로다.
#
#   BREAK_EVEN_R      이 R에 닿으면 손절을 본전(진입가)으로   (기본 1)
#   TRAIL_START_R     이 R을 넘으면 트레일링 시작             (기본 2)
#   TRAIL_DISTANCE_R  최고점에서 이만큼 뒤로 물러난 자리로     (기본 1)
#
# 끄려면 TRAILING_STOP=off. 최고 도달 R이나 현재가를 확인하지 못한 주기는
# 그냥 건너뛴다 — 모르는 값을 0으로 치면 본전 이동이 영원히 안 걸린다.
TRAILING_STOP=
TRAIL_START_R=
TRAIL_DISTANCE_R=
BREAK_EVEN_R=

# ── 데모(모의) 자동매매 러너 ──────────────────────────────────
# /api/paper/run 한 번 = 한 사이클: 청산 점검 → 일일 손실 한도 → 진입.
# 터미널의 [데모 자동매매] 스위치가 이 주소를 주기적으로 부른다.
# **창을 닫으면 멈춘다.** 계속 돌리려면 서버 스케줄러가 같은 주소를 부르면 된다.
#
# 진입 규칙은 하나다: 국면이 알려주는 **추세 방향으로만** 들어간다
# (상승→롱, 하락→숏, 횡보→진입 없음). 여기에 우위가 있다고 말하지 않는다 —
# 정해진 규칙을 그대로 지키는지 보려는 것이고, 우위는 백테스트가 답할 질문이다.
#
#   PAPER_SYMBOLS         볼 종목 (쉼표 구분, 기본 BTCUSDT)
#   PAPER_RISK_PCT        한 번에 걸 위험 (가용 잔고 대비 %, 기본 1)
#   PAPER_STOP_PCT        손절 폭 % (기본 2). 수량은 이 거리로 정해진다
#   PAPER_TP_PCT          익절 폭 % (기본 4). 0이면 익절 없이 트레일링에 맡긴다
#   PAPER_LEVERAGE        배율 (기본 5)
#   PAPER_MAX_POSITIONS   동시에 열어 둘 포지션 수 (기본 1)
#   PAPER_MAX_HOLD_HOURS  이 시간을 넘기면 시간 청산 (기본 72)
PAPER_SYMBOLS=
PAPER_RISK_PCT=
PAPER_STOP_PCT=
PAPER_TP_PCT=
PAPER_LEVERAGE=
PAPER_MAX_POSITIONS=
PAPER_MAX_HOLD_HOURS=

# ── 운영자 승급 (첫 로그인 시 자동) ───────────────────────────
# 여기 적은 이메일로 로그인하면 /api/auth/me가 profiles.role을 올려 준다.
# **올리기만 한다** — 이미 더 높은 등급이면 건드리지 않는다.
#
# 등급 순서: user < vip < lifetime < founder < admin < developer < super_admin
#   ADMIN_EMAILS        → admin        : /admin 열림. /developer는 안 열린다
#   DEVELOPER_EMAILS    → developer    : /admin + /developer
#   SUPER_ADMIN_EMAILS  → super_admin  : 전부
#
# 소유자 계정 하나만 쓸 거면 SUPER_ADMIN_EMAILS에 적으면 된다.
# 쉼표·세미콜론·공백 어느 것으로 나눠도 되고, 대소문자는 무시한다.
# Example: SUPER_ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=
DEVELOPER_EMAILS=
SUPER_ADMIN_EMAILS=

# ── Encryption (generate: openssl rand -hex 16) ───────────────
EXCHANGE_ENCRYPTION_KEY=
